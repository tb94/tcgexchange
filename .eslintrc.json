{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    // Customize here
    "no-console": "off",
    "comma-dangle": ["error", "never"],
    "import/extensions": "off",
    "no-underscore-dangle": "off"
  }
}
